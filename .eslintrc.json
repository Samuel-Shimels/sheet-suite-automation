{
  "env": {
    "es6": true,
    "browser": true,
    "googleappsscript": true,
    "node": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": 2021
  },
  "rules": {
    "semi": ["error", "always"],
    "quotes": ["error", "double"],
    "no-unused-vars": ["warn"],
    "no-console": "off",
    "indent": ["error", 2]
  }
}
